# ---------------------------------------------------------------------------
# Callback — environment
# Copy to .env.local for development. On Vercel, set these in Project Settings
# → Environment Variables. Never commit a real key.
# ---------------------------------------------------------------------------

# AI — required for the match analysis and the pivot suggestions.
# Free tier key from https://aistudio.google.com/apikey
# Without it the app still runs: the rule-based ATS check works, and the match
# tab shows a retry (PRD §11).
GEMINI_API_KEY=

# Optional model overrides. Both default to the fast model so each call stays
# inside the 60 s route budget; gemini-3.8-flash writes better prose for the
# pivot but measured at 100-250 s per call.
# GEMINI_MODEL_ANALYZE=gemini-3.5-flash-lite
# GEMINI_MODEL_PIVOT=gemini-3.5-flash-lite

# Optional reasoning effort (minimal | low | medium | high). Higher is slower;
# the defaults keep each call well inside the 60 s route budget.
# GEMINI_THINKING_ANALYZE=minimal
# GEMINI_THINKING_PIVOT=low

# Rate limiting (PRD §4: 8 analyses per IP per day).
# Vercel functions are stateless, so without these the limit falls back to an
# in-process counter that resets on cold starts. Free tier at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deployed Callback.sol address (PRD §13 keeps this in one constant).
# Fill in after deploying via Remix. Until it is set, the stamping UI is
# disabled rather than broken.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Point at BOT Chain testnet (Bohr, chain 968) instead of mainnet (677).
# NEXT_PUBLIC_USE_TESTNET=1

# Canonical site origin, used for share links and metadata.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL if unset.
# NEXT_PUBLIC_SITE_URL=https://callback.example
