# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and contracts/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env*.local
.env

# Generated: copied from node_modules on predev/prebuild
/public/vendor/

# Solidity build output
/contracts/artifacts/
/contracts/cache/
/contracts/types/

# Local AI agent tooling, not part of the app
.agents/
.claude/
.codegraph/
skills-lock.json
AGENTS.md
CLAUDE.md

# Stray build output from before turbopack.root was pinned
/ProjectBuilder/

